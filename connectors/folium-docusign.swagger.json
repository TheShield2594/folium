{
  "swagger": "2.0",
  "info": {
    "title": "Folium DocuSign",
    "description": "The DocuSign eSignature REST v2.1 operations Folium uses, on the account named in Folium's Administration › Settings: check the account, create an envelope from Folium's own PDFs with page + x/y tabs, read status, void/resend, correct recipients, open in-session signing, download the signed PDF and certificate.",
    "version": "1.0"
  },
  "host": "demo.docusign.net",
  "basePath": "/restapi/v2.1",
  "schemes": ["https"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "securityDefinitions": {
    "oauth2_auth": {
      "type": "oauth2",
      "flow": "accessCode",
      "authorizationUrl": "https://account-d.docusign.com/oauth/auth",
      "tokenUrl": "https://account-d.docusign.com/oauth/token",
      "scopes": { "signature": "Create and manage envelopes" }
    }
  },
  "security": [{ "oauth2_auth": ["signature"] }],
  "parameters": {
    "accountId": { "name": "accountId", "in": "path", "required": true, "type": "string", "description": "DocuSign API Account ID (GUID). Folium passes it from Administration › Settings › DocuSign." },
    "envelopeId": { "name": "envelopeId", "in": "path", "required": true, "type": "string" }
  },
  "paths": {
    "/accounts/{accountId}": {
      "get": {
        "operationId": "GetAccount",
        "summary": "Check the connection reaches the account",
        "description": "Folium's Test connection and Check my DocuSign sign-in. Fails when the signed-in DocuSign user isn't in the account.",
        "parameters": [{ "$ref": "#/parameters/accountId" }],
        "responses": {
          "200": { "description": "OK", "schema": { "type": "object", "properties": { "accountName": { "type": "string" }, "accountIdGuid": { "type": "string" } } } }
        }
      }
    },
    "/accounts/{accountId}/envelopes": {
      "post": {
        "operationId": "CreateEnvelope",
        "summary": "Create and send an envelope",
        "parameters": [
          { "$ref": "#/parameters/accountId" },
          { "name": "body", "in": "body", "required": true, "schema": { "type": "object", "description": "envelopeDefinition built by buildEnvelopeDefinition()" } }
        ],
        "responses": {
          "201": { "description": "Created", "schema": { "type": "object", "properties": { "envelopeId": { "type": "string" }, "status": { "type": "string" }, "statusDateTime": { "type": "string" } } } }
        }
      }
    },
    "/accounts/{accountId}/envelopes/{envelopeId}": {
      "get": {
        "operationId": "GetEnvelope",
        "summary": "Get envelope status",
        "parameters": [
          { "$ref": "#/parameters/accountId" },
          { "$ref": "#/parameters/envelopeId" },
          { "name": "include", "in": "query", "required": false, "type": "string", "default": "recipients" }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "object",
              "properties": {
                "status": { "type": "string" },
                "voidedReason": { "type": "string", "description": "Why the envelope was voided; DocuSign gives an expiry reason when it lapsed" },
                "expireDateTime": { "type": "string", "description": "When the envelope expires (or expired)" },
                "deliveredDateTime": { "type": "string" },
                "completedDateTime": { "type": "string" },
                "recipients": { "type": "object" }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "UpdateEnvelope",
        "summary": "Send a draft envelope, void it, or resend it",
        "parameters": [
          { "$ref": "#/parameters/accountId" },
          { "$ref": "#/parameters/envelopeId" },
          { "name": "resend_envelope", "in": "query", "required": false, "type": "boolean" },
          { "name": "body", "in": "body", "required": true, "schema": { "type": "object", "properties": { "status": { "type": "string" }, "voidedReason": { "type": "string" } } } }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/accounts/{accountId}/envelopes/{envelopeId}/recipients": {
      "put": {
        "operationId": "UpdateRecipients",
        "summary": "Correct recipient details",
        "parameters": [
          { "$ref": "#/parameters/accountId" },
          { "$ref": "#/parameters/envelopeId" },
          { "name": "resend_envelope", "in": "query", "required": false, "type": "boolean" },
          { "name": "body", "in": "body", "required": true, "schema": { "type": "object", "properties": { "signers": { "type": "array", "items": { "type": "object" } } } } }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/accounts/{accountId}/envelopes/{envelopeId}/views/recipient": {
      "post": {
        "operationId": "CreateRecipientView",
        "summary": "Get a short-lived link for an in-session (embedded) signer",
        "parameters": [
          { "$ref": "#/parameters/accountId" },
          { "$ref": "#/parameters/envelopeId" },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "userName": { "type": "string" },
                "email": { "type": "string" },
                "recipientId": { "type": "string" },
                "clientUserId": { "type": "string" },
                "returnUrl": { "type": "string" },
                "authenticationMethod": { "type": "string", "default": "None" }
              }
            }
          }
        ],
        "responses": { "201": { "description": "Created", "schema": { "type": "object", "properties": { "url": { "type": "string" } } } } }
      }
    },
    "/accounts/{accountId}/envelopes/{envelopeId}/documents/{documentId}": {
      "get": {
        "operationId": "GetDocument",
        "summary": "Download a document (use 'combined' or 'certificate')",
        "produces": ["application/pdf"],
        "parameters": [
          { "$ref": "#/parameters/accountId" },
          { "$ref": "#/parameters/envelopeId" },
          { "name": "documentId", "in": "path", "required": true, "type": "string" }
        ],
        "responses": { "200": { "description": "PDF", "schema": { "type": "string", "format": "binary" } } }
      }
    }
  }
}
