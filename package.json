    "@microsoft/power-apps-vite": "1.0.13",
    "@playwright/test": "1.56.1",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.3",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
